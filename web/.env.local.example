# Consola interna Estampados — copiar como web/.env.local
#
# Solo se necesitan estas dos variables. Ambas son publicas por diseno:
# la seguridad la impone RLS en PostgreSQL, no el secreto de la clave.
#
# NUNCA agregues aqui la clave privilegiada de Supabase. La consola de la
# Etapa B es de solo lectura y usa la sesion del usuario; si alguna consulta
# parece necesitar mas permisos, el error esta en la politica RLS, no aqui.

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
