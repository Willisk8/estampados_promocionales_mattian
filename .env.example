# =============================================================================
# ESTAMPADOS MVP — Variables de entorno para STAGING
# Copiar este archivo como .env.staging y completar con valores reales.
# NUNCA commitear .env.staging ni ningún archivo con valores reales.
# =============================================================================

# --- Supabase STAGING ---
# Obtener en: Supabase Dashboard → Settings → API
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# La service_role key NUNCA debe usarse en el frontend. Solo en scripts backend/n8n.

# --- Base de datos PostgreSQL directa (para migraciones con psql) ---
# Obtener en: Supabase Dashboard → Settings → Database
DATABASE_URL=postgresql://postgres:PASSWORD@db.TU_PROJECT_ID.supabase.co:5432/postgres
# Alternativa con pooler (recomendado para scripts):
# La URL exacta aparece en Supabase Dashboard → Settings → Database → Connection pooling
DATABASE_URL_POOLER=postgresql://postgres.TU_PROJECT_ID:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Seguridad ---
# Clave HMAC para hashing de emails suprimidos. Mínimo 32 caracteres aleatorios.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SUPPRESSION_SECRET=your-hmac-secret-here

# --- Configuración de entorno ---
ENVIRONMENT=staging
LOG_LEVEL=DEBUG

# --- Import pipeline ---
# Ruta base para archivos fuente del scraping
SCRAPING_BASE_PATH=./scraping

# --- n8n STAGING (cuando se configure) ---
# N8N_BASE_URL=http://localhost:5678
# N8N_API_KEY=your-n8n-api-key-here
# N8N_ENCRYPTION_KEY=your-encryption-key-here

# --- IA (cuando se configure) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# AI_MAX_CALLS_PER_MESSAGE=3
# AI_DAILY_BUDGET_USD=5.00
